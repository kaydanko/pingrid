{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pingrid",
  "version": "0.1.0",
  "identifier": "app.syntrope.pingrid",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pingrid",
        "width": 1280,
        "height": 800,
        "minWidth": 300,
        "minHeight": 400,
        "backgroundColor": "#0a0c0f",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Uptime & SSL wallboard",
    "longDescription": "Pingrid is a local-first uptime and SSL certificate monitor with an adaptive wallboard. No accounts, no cloud.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
