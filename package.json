    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-sql": "^2.3.0",
    "lucide-react": "^1.81.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^22.20.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.3.0",
